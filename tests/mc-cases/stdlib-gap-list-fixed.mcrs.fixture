namespace gap_list_fixed

fn test_gap() {
  scoreboard_set("#sort2_min", "gap_result", sort2_min(7, 3))
  scoreboard_set("#sort2_max", "gap_result", sort2_max(3, 7))
  scoreboard_set("#min3", "gap_result", list_min3(5, -2, 8))
  scoreboard_set("#max3", "gap_result", list_max3(5, -2, 8))
  scoreboard_set("#min5", "gap_result", list_min5(5, -2, 8, -9, 7))
  scoreboard_set("#max5", "gap_result", list_max5(5, -2, 8, 9, 7))
  scoreboard_set("#sum3", "gap_result", list_sum3(1, 2, 3))
  scoreboard_set("#sum4", "gap_result", list_sum4(1, 2, 3, 4))
  scoreboard_set("#sum5", "gap_result", list_sum5(1, 2, 3, 4, 5))
  scoreboard_set("#avg3", "gap_result", avg3(1, 2, 4))
  scoreboard_set("#avg5", "gap_result", avg5(1, 2, 3, 4, 5))
  scoreboard_set("#sort3_0", "gap_result", sort3(3, 1, 2, 0))
  scoreboard_set("#sort3_1", "gap_result", sort3(3, 1, 2, 1))
  scoreboard_set("#sort3_2", "gap_result", sort3(3, 1, 2, 2))
  scoreboard_set("#sort4_0", "gap_result", sort4(4, 1, 3, 2, 0))
  scoreboard_set("#sort4_1", "gap_result", sort4(4, 1, 3, 2, 1))
  scoreboard_set("#sort4_2", "gap_result", sort4(4, 1, 3, 2, 2))
  scoreboard_set("#sort4_3", "gap_result", sort4(4, 1, 3, 2, 3))
  scoreboard_set("#sort5_0", "gap_result", sort5(5, 1, 4, 2, 3, 0))
  scoreboard_set("#sort5_1", "gap_result", sort5(5, 1, 4, 2, 3, 1))
  scoreboard_set("#sort5_2", "gap_result", sort5(5, 1, 4, 2, 3, 2))
  scoreboard_set("#sort5_3", "gap_result", sort5(5, 1, 4, 2, 3, 3))
  scoreboard_set("#sort5_4", "gap_result", sort5(5, 1, 4, 2, 3, 4))
  scoreboard_set("#weighted2_0", "gap_result", weighted2(1, 1, 1))
  scoreboard_set("#weighted2_1", "gap_result", weighted2(0, 1, 1))
  scoreboard_set("#weighted3_0", "gap_result", weighted3(1, 1, 1, 1))
  scoreboard_set("#weighted3_1", "gap_result", weighted3(0, 1, 1, 1))
  scoreboard_set("#weighted3_2", "gap_result", weighted3(2, 1, 1, 1))
}