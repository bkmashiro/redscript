namespace gap_timer

fn test_gap() {
  scoreboard_set("#to_seconds", "gap_result", tick_to_seconds(40))
  scoreboard_set("#to_ms", "gap_result", tick_to_ms(10))
  scoreboard_set("#to_ticks", "gap_result", seconds_to_ticks(3))
  scoreboard_set("#fmt_s", "gap_result", format_time_s(1500))
  scoreboard_set("#fmt_m", "gap_result", format_time_m(73200))
  scoreboard_set("#fmt_h", "gap_result", format_time_h(144000))

  let a: Timer = Timer::new(3)
  let b: Timer = Timer::new(5)
  scoreboard_set("#a_initial_elapsed", "gap_result", a.elapsed())
  scoreboard_set("#a_initial_remaining", "gap_result", a.remaining())
  scoreboard_set("#a_initial_done", "gap_result", a.done())
  a.tick()
  scoreboard_set("#a_inactive_tick", "gap_result", a.elapsed())
  a.start()
  a.tick()
  a.tick()
  scoreboard_set("#a_elapsed_two", "gap_result", a.elapsed())
  scoreboard_set("#a_remaining_one", "gap_result", a.remaining())
  scoreboard_set("#a_done_two", "gap_result", a.done())
  a.pause()
  a.tick()
  scoreboard_set("#a_paused_tick", "gap_result", a.elapsed())
  a.start()
  a.tick()
  a.tick()
  scoreboard_set("#a_capped_elapsed", "gap_result", a.elapsed())
  scoreboard_set("#a_done_three", "gap_result", a.done())
  scoreboard_set("#a_remaining_zero", "gap_result", a.remaining())
  scoreboard_set("#b_isolated_elapsed", "gap_result", b.elapsed())
  scoreboard_set("#b_isolated_remaining", "gap_result", b.remaining())
  a.reset()
  scoreboard_set("#a_reset_elapsed", "gap_result", a.elapsed())
  scoreboard_set("#a_reset_remaining", "gap_result", a.remaining())
  scoreboard_set("#a_reset_done", "gap_result", a.done())
}